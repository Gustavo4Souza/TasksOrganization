{
  "name": "@tasksorg/api",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "main": "dist/server.js",
  "scripts": {
    "build": "tsc -p tsconfig.json",
    "dev": "tsx watch src/server.ts",
    "start": "node dist/server.js",
    "lint": "eslint . --max-warnings 0",
    "typecheck": "tsc -p tsconfig.json --noEmit",
    "test": "vitest run",
    "test:integration": "vitest run test/api.integration.test.ts"
  },
  "dependencies": {
    "@fastify/cookie": "^11.0.2",
    "@fastify/cors": "^11.1.0",
    "@fastify/rate-limit": "11.2.2",
    "@tasksorg/core": "workspace:*",
    "fastify": "^5.6.2",
    "pg": "^8.16.3",
    "zod": "^4.1.12"
  },
  "devDependencies": {
    "@tasksorg/eslint-config": "workspace:*",
    "@tasksorg/tsconfig": "workspace:*",
    "@types/node": "^26.6.6",
    "@types/pg": "^8.15.6",
    "eslint": "^10.14.0",
    "tsx": "^4.20.6",
    "typescript": "^6.0.3",
    "vitest": "^5.1.0"
  }
}
