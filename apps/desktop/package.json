{
  "name": "@tasksorg/desktop",
  "version": "0.1.0",
  "description": "Aplicativo Desktop do TasksOrg com quadro de missões e Pomodoro.",
  "author": "TasksOrg Team",
  "private": true,
  "main": "dist/main.js",
  "scripts": {
    "build": "tsc -p tsconfig.json && node esbuild.renderer.mjs",
    "dist:win": "npm run build && electron-builder --win --publish never",
    "dev": "npm run build && electron .",
    "start": "electron .",
    "lint": "eslint . --max-warnings 0",
    "typecheck": "tsc -p tsconfig.json --noEmit",
    "test": "vitest run"
  },
  "dependencies": {
    "@tasksorg/core": "workspace:*",
    "@tasksorg/ui": "workspace:*",
    "react": "^18.3.1",
    "react-dom": "^19.3.1"
  },
  "devDependencies": {
    "@tasksorg/eslint-config": "workspace:^",
    "@tasksorg/tsconfig": "workspace:^",
    "@types/node": "^20.16.11",
    "@types/react": "^18.3.11",
    "@types/react-dom": "^19.3.0",
    "electron-builder": "^26.0.12",
    "electron": "^42.11.16",
    "esbuild": "^0.28.2",
    "eslint": "^9",
    "typescript": "^5.6.3",
    "vitest": "^4.1.12"
  },
  "build": {
    "appId": "com.tasksorg.desktop",
    "productName": "TasksOrg",
    "directories": {
      "output": "release"
    },
    "files": [
      "dist/**/*",
      "renderer/**/*",
      "package.json"
    ],
    "extraResources": [
      {
        "from": "../mobile/assets/icon.png",
        "to": "tasksorg-icon.png"
      }
    ],
    "win": {
      "target": "nsis",
      "icon": "../mobile/assets/icon.png"
    },
    "nsis": {
      "oneClick": false,
      "allowToChangeInstallationDirectory": true
    }
  }
}
