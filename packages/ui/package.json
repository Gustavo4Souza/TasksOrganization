{
  "name": "@tasksorg/ui",
  "version": "0.1.0",
  "private": true,
  "description": "Design System pixel compartilhado do TasksOrg.",
  "type": "module",
  "main": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js"
    },
    "./components": {
      "types": "./dist/components.d.ts",
      "import": "./dist/components.js"
    },
    "./styles.css": "./dist/styles.css",
    "./tokens.css": "./dist/tokens.css",
    "./tokens.json": "./dist/tokens.json",
    "./hooks": {
      "types": "./dist/hooks.d.ts",
      "import": "./dist/hooks.js"
    },
    "./native": {
      "types": "./dist/native.d.ts",
      "import": "./dist/native.js"
    }
  },
  "files": [
    "dist"
  ],
  "sideEffects": [
    "./dist/styles.css",
    "./dist/tokens.css"
  ],
  "scripts": {
    "build": "node scripts/build-tokens.mjs --check && tsc -p tsconfig.json && node scripts/copy-css.mjs",
    "dev": "tsc -p tsconfig.json --watch",
    "lint": "eslint . --max-warnings 0",
    "typecheck": "tsc -p tsconfig.json --noEmit && tsc -p tsconfig.test.json",
    "test": "vitest run",
    "tokens": "node scripts/build-tokens.mjs"
  },
  "peerDependencies": {
    "react": "^18.3.1 || ^19.0.0",
    "react-dom": "^18.3.1 || ^19.0.0"
  },
  "peerDependenciesMeta": {
    "react-dom": {
      "optional": true
    }
  },
  "devDependencies": {
    "@tasksorg/eslint-config": "workspace:^",
    "@tasksorg/tsconfig": "workspace:^",
    "@testing-library/dom": "^10",
    "@testing-library/react": "^16",
    "@types/react": "^19.3.0",
    "@types/react-dom": "^19.3.0",
    "eslint": "^10",
    "jsdom": "^30",
    "react": "^19.3.1",
    "react-dom": "^19.3.1",
    "typescript": "^6.0.3",
    "vitest": "^5.1.0"
  },
  "dependencies": {
    "@tasksorg/core": "workspace:^"
  }
}
