{
  "name": "@tasksorg/ui",
  "version": "0.1.0",
  "private": true,
  "description": "Design System pixel compartilhado do TasksOrg.",
  "type": "module",
  "main": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js"
    },
    "./components": {
      "types": "./dist/components.d.ts",
      "import": "./dist/components.js"
    },
    "./styles.css": "./dist/styles.css",
    "./tokens.css": "./dist/tokens.css",
    "./tokens.json": "./dist/tokens.json"
  },
  "files": [
    "dist"
  ],
  "sideEffects": [
    "./dist/styles.css",
    "./dist/tokens.css"
  ],
  "scripts": {
    "build": "node scripts/build-tokens.mjs --check && tsc -p tsconfig.json && node scripts/copy-css.mjs",
    "dev": "tsc -p tsconfig.json --watch",
    "lint": "eslint . --max-warnings 0",
    "typecheck": "tsc -p tsconfig.json --noEmit",
    "test": "vitest run",
    "tokens": "node scripts/build-tokens.mjs"
  },
  "peerDependencies": {
    "react": "^18.3.1",
    "react-dom": "^18.3.1"
  },
  "devDependencies": {
    "@tasksorg/eslint-config": "workspace:^",
    "@tasksorg/tsconfig": "workspace:^",
    "@types/react": "^18.3.11",
    "@types/react-dom": "^18.3.1",
    "eslint": "^9",
    "react": "^18.3.1",
    "react-dom": "^18.3.1",
    "typescript": "^5.6.3",
    "vitest": "^2.1.4"
  }
}
