{
  "name": "tasks-organization",
  "private": true,
  "version": "0.1.0",
  "description": "POC multiplataforma de um app de organização de tarefas (web, desktop, mobile) inspirado no Notion.",
  "packageManager": "pnpm@9.12.0",
  "engines": {
    "node": ">=20"
  },
  "pnpm": {
    "overrides": {
      "brace-expansion@^1.1.8": "1.1.21",
      "brace-expansion@^5.0.0": "5.0.12",
      "js-yaml@^4.1.0": "4.3.2",
      "postcss@^8.4.31": "8.5.32",
      "source-map-js@^1.2.0": "1.2.2",
      "vite": "7.3.7"
    }
  },
  "scripts": {
    "build": "turbo run build",
    "dev": "turbo run dev",
    "lint": "turbo run lint",
    "typecheck": "turbo run typecheck",
    "test": "turbo run test",
    "test:e2e": "turbo run build --filter=@tasksorg/web && pnpm --filter @tasksorg/web test:e2e"
  },
  "devDependencies": {
    "turbo": "^2.1.3",
    "typescript": "^5.6.3"
  }
}
